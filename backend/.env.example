NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=mysql://root:123456@127.0.0.1:3306/clinic

JWT_SECRET=clinic-secret-2026
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# File uploads (currently: doctor/staff avatars, see UploadsController).
# Leave S3_BUCKET empty to fall back to local disk storage under ./uploads
# (LocalDiskStorageAdapter) — fine for local dev, but files are lost on
# redeploy/restart and aren't shared across instances, so a real deployment
# must set S3_BUCKET to use S3StorageAdapter instead.
#
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY: leave BOTH empty on EC2 — attach
# an IAM Role (instance profile) with S3 access to the instance instead;
# the AWS SDK picks up its temporary credentials automatically, no static
# key needed (see docs/deployment/aws-setup-guide.md). Only set these two
# for local development off AWS infrastructure, where no instance role is
# available — never commit real values here.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=clinic-files
CLOUDFRONT_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: bare address or full "Display Name <address>" header. Leave empty
# to default to "<CLINIC_NAME>" <no-reply@aucophuha.vn> (see smtp-email.adapter.ts).
SMTP_FROM="Phòng Khám Đa Khoa Âu Cơ Phú Hà" <no-reply@aucophuha.vn>
SMTP_SECURE=false

# AI clinic assistant (Feature 83/86/87) — free API key from console.groq.com.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# PDF generation (queue tickets, exam results, prescriptions, CLS orders) —
# path to a Unicode TTF font that supports Vietnamese diacritics. Leave empty
# to use the built-in Windows/Linux/Noto/DejaVu font search in pdf.service.ts;
# set explicitly on deploy targets that don't have one of those paths (e.g.
# a minimal Docker base image without fonts-dejavu-core/fonts-noto installed).
PDF_FONT_PATH=
PDF_FONT_BOLD_PATH=

# Anti-spam thresholds for the appointment booking flow (version-up 0.2,
# item #7) — see src/config/app.config.ts's `booking` section for defaults.
BOOKING_GUEST_RATE_LIMIT=5
BOOKING_GUEST_RATE_LIMIT_TTL_MS=3600000
BOOKING_PATIENT_RATE_LIMIT=10
BOOKING_PATIENT_RATE_LIMIT_TTL_MS=3600000
BOOKING_MAX_PENDING_APPOINTMENTS=3
BOOKING_NO_SHOW_TRUST_THRESHOLD=2
BOOKING_NO_SHOW_LOOKBACK_DAYS=90

# Public clinic info page (GET /api/v1/public/clinic-info) — leave empty to
# keep the defaults defined in src/config/clinic.config.ts
CLINIC_NAME=
CLINIC_DESCRIPTION=
CLINIC_ADDRESS=
CLINIC_PHONE=
CLINIC_SUPPORT_PHONE=
CLINIC_EMAIL=
CLINIC_OPERATING_HOURS=
CLINIC_EXAMINATION_STEPS=
