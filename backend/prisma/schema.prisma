generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// NOTES â€” limitations of this MySQL/Prisma mapping vs docs/database_design.md
// =====================================================================
// 1. CHECK constraints described in database_design.md (e.g.
//    chk_cancel_has_reason, chk_invoice_total, chk_invoice_amount_due,
//    chk_paid_has_method, chk_invoice_item_ref, chk_invoice_item_amount,
//    chk_supply_tx_quantity,
//    chk_supply_tx_import_ref, chk_supply_tx_room_ref,
//    chk_return_reviewed, chk_cls_room_type)
//    are NOT representable in Prisma schema. They must be enforced at the
//    application layer (use-case validation) and/or added via raw SQL in
//    migrations.
// 2. Partial unique indexes (e.g. uq_one_inprogress_per_room,
//    uq_one_inprogress_per_cls_room, partial indexes WHERE deleted_at IS
//    NULL) are NOT supported by MySQL/Prisma. Equivalent invariants must be
//    enforced at the application layer (e.g. check-then-write inside a
//    transaction, or a unique index on a generated "lock" column).
// 3. PostgreSQL-only types are mapped as follows: UUID -> Char(36),
//    TIMESTAMPTZ -> DateTime, NUMERIC(15,2) -> Decimal(15,2), JSONB -> Json,
//    INET -> VarChar(45).
// =====================================================================

// =====================================================================
// ENUMS
// =====================================================================

enum UserRole {
  ADMIN
  RECEPTIONIST
  DOCTOR
  NURSE
  LAB_TECH
  PATIENT
}

enum OtpPurpose {
  FORGOT_PASSWORD
  VERIFY_PHONE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SeverityLevel {
  MILD
  MODERATE
  SEVERE
}

enum RoomType {
  EXAMINATION
  CLS
  ADMIN
}

// Only meaningful when Room.type = CLS — which CLS specialty this room
// performs (Xét nghiệm / X-quang / Siêu âm), so orders/rooms/print forms can
// be grouped by specialty instead of lumping every CLS room together.
enum ClsRoomCategory {
  LAB
  XRAY
  ULTRASOUND
  ECG
}

enum ServiceType {
  EXAMINATION
  CLS
}

enum ShiftType {
  MORNING
  AFTERNOON
  FULL_DAY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VisitStatus {
  WAITING
  CALLED
  IN_PROGRESS
  AWAITING_RESULTS
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum VisitPriority {
  NORMAL
  ELDERLY
  PREGNANT
  CHILD
  EMERGENCY
}

enum ClsOrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttachmentFileType {
  PDF
  JPG
  PNG
  DICOM
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum InvoiceItemType {
  SERVICE
  CLS
  MEDICINE
}

enum SupplyTransactionType {
  IMPORT
  DISTRIBUTE
}

enum MeasurementUnit {
  VIEN // Viên
  VI // Vỉ
  HOP // Hộp
  CHAI // Chai
  ONG // Ống
  GOI // Gói
  TUYP // Tuýp
  LO // Lọ
  CAI // Cái
  BO // Bộ
  KHAC // Khác (fallback for legacy free-text values that don't map cleanly)
}

enum DoctorProfileApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum NotificationChannel {
  EMAIL
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// =====================================================================
// I. AUTHENTICATION & USER MODULE
// =====================================================================

model User {
  id                 String    @id @default(uuid()) @db.Char(36)
  fullName           String    @map("full_name") @db.VarChar(100)
  // Nullable (2026-08-07) — email is no longer mandatory when creating a
  // patient/staff account; login still works via phone or idCard (see
  // LoginUseCase / findByEmailOrPhone). MySQL's unique index allows any
  // number of NULLs, so this doesn't relax the "no two accounts share a
  // real email" guarantee.
  email              String?   @unique @db.VarChar(150)
  phone              String    @unique @db.VarChar(15)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  idCard             String?   @unique @map("id_card") @db.VarChar(20)
  role               UserRole
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  failedLoginCount   Int       @default(0) @map("failed_login_count") @db.SmallInt
  lockedAt           DateTime? @map("locked_at")
  lastLoginAt        DateTime? @map("last_login_at")
  // Non-doctor staff (NURSE / LAB_TECH / RECEPTIONIST) department grouping,
  // for room-picker filtering only — no other business rule depends on it.
  // Doctors use DoctorProfile.specialtyId instead (that one is load-bearing
  // for the booking flow).
  specialtyId        String?   @map("specialty_id") @db.Char(36)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy          String?   @map("created_by") @db.Char(36)
  updatedBy          String?   @map("updated_by") @db.Char(36)
  deletedAt          DateTime? @map("deleted_at")

  patientProfile Patient?
  doctorProfile  DoctorProfile?
  specialty      Specialty?     @relation(fields: [specialtyId], references: [id])
  refreshTokens  RefreshToken[]
  otpTokens      OtpToken[]
  workSchedules  WorkSchedule[]

  appointmentsAsDoctor Appointment[] @relation("AppointmentDoctor")
  visitsAsDoctor       Visit[]       @relation("VisitDoctor")
  aiChatLogs           AiChatLog[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([specialtyId])
  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Char(36)
  userId            String    @map("user_id") @db.Char(36)
  tokenHash         String    @unique @map("token_hash") @db.VarChar(255)
  deviceInfo        String?   @map("device_info") @db.Text
  ipAddress         String?   @map("ip_address") @db.VarChar(45)
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Char(36)
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpToken {
  id        String     @id @default(uuid()) @db.Char(36)
  userId    String     @map("user_id") @db.Char(36)
  otpCode   String     @map("otp_code") @db.Char(6)
  purpose   OtpPurpose
  expiresAt DateTime   @map("expires_at")
  usedAt    DateTime?  @map("used_at")
  createdAt DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("otp_tokens")
}

// =====================================================================
// II. PATIENT MODULE
// =====================================================================

model Patient {
  id                  String    @id @default(uuid()) @db.Char(36)
  patientCode         String    @unique @map("patient_code") @db.VarChar(20)
  fullName            String    @map("full_name") @db.VarChar(100)
  email               String?   @db.VarChar(150)
  dateOfBirth         DateTime  @map("date_of_birth") @db.Date
  gender              Gender
  phone               String    @db.VarChar(15)
  idCard              String?   @unique @map("id_card") @db.VarChar(20)
  address             String?   @db.Text
  note                String?   @db.Text
  notificationConsent Boolean   @default(false) @map("notification_consent")
  userId              String?   @unique @map("user_id") @db.Char(36)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy           String    @map("created_by") @db.Char(36)
  updatedBy           String?   @map("updated_by") @db.Char(36)
  deletedAt           DateTime? @map("deleted_at")

  user User? @relation(fields: [userId], references: [id])

  allergies     PatientAllergy[]
  appointments  Appointment[]
  visits        Visit[]
  invoices      Invoice[]
  medicalRecord MedicalRecord?

  @@index([phone])
  @@index([email])
  @@index([patientCode])
  @@index([fullName])
  @@map("patients")
}

model MedicalRecord {
  id               String   @id @default(uuid()) @db.Char(36)
  patientId        String   @unique @map("patient_id") @db.Char(36)
  medicalHistory   String?  @map("medical_history") @db.Text
  clinicalNote     String?  @map("clinical_note") @db.Text
  diagnosisSummary String?  @map("diagnosis_summary") @db.Text
  treatmentSummary String?  @map("treatment_summary") @db.Text
  followUpNote     String?  @map("follow_up_note") @db.Text
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy        String   @map("created_by") @db.Char(36)
  updatedBy        String?  @map("updated_by") @db.Char(36)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([updatedAt(sort: Desc)])
  @@map("medical_records")
}

model PatientAllergy {
  id          String        @id @default(uuid()) @db.Char(36)
  patientId   String        @map("patient_id") @db.Char(36)
  allergen    String        @db.VarChar(100)
  severity    SeverityLevel
  description String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  createdBy   String        @map("created_by") @db.Char(36)

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_allergies")
}

// =====================================================================
// III. ROOM MODULE
// =====================================================================

model Room {
  id            String           @id @default(uuid()) @db.Char(36)
  roomCode      String           @unique @map("room_code") @db.VarChar(20)
  name          String           @db.VarChar(100)
  type          RoomType
  description   String?          @db.Text
  techniqueType String?          @map("technique_type") @db.VarChar(150)
  clsCategory   ClsRoomCategory? @map("cls_category")
  // Which specialty (chuyên khoa) this room belongs to. For EXAMINATION
  // rooms it's the clinical department; CLS rooms also get one (e.g.
  // "Chẩn đoán hình ảnh" / "Xét nghiệm" are treated as specialties in their
  // own right), in addition to the existing clsCategory. Purely for
  // room-picker filtering — no other business rule depends on it.
  specialtyId   String?          @map("specialty_id") @db.Char(36)
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at")
  createdBy     String           @map("created_by") @db.Char(36)
  updatedBy     String?          @map("updated_by") @db.Char(36)
  deletedAt     DateTime?        @map("deleted_at")

  specialty          Specialty?          @relation(fields: [specialtyId], references: [id])
  workSchedules      WorkSchedule[]
  appointments       Appointment[]
  visits             Visit[]
  clsOrders          ClsOrder[]          @relation("ClsOrderRoom")
  supplyTransactions SupplyTransaction[]

  @@index([type])
  @@index([isActive])
  @@index([specialtyId])
  @@map("rooms")
}

// =====================================================================
// IV. SERVICE MODULE
// =====================================================================

model Service {
  id          String           @id @default(uuid()) @db.Char(36)
  serviceCode String?          @unique @map("service_code") @db.VarChar(20)
  name        String           @unique @db.VarChar(150)
  specialtyId String?          @map("specialty_id") @db.Char(36)
  type        ServiceType      @default(EXAMINATION)
  clsCategory ClsRoomCategory? @map("cls_category")
  price       Decimal          @db.Decimal(15, 2)
  description String?          @db.Text
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at")
  createdBy   String           @map("created_by") @db.Char(36)
  updatedBy   String?          @map("updated_by") @db.Char(36)
  deletedAt   DateTime?        @map("deleted_at")

  specialty    Specialty?    @relation(fields: [specialtyId], references: [id])
  appointments Appointment[]
  clsOrders    ClsOrder[]
  invoiceItems InvoiceItem[]

  @@index([specialtyId])
  @@map("services")
}

// =====================================================================
// V. DOCTOR MODULE
// =====================================================================

model Specialty {
  id          String   @id @default(uuid()) @db.Char(36)
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  doctorProfiles              DoctorProfile[]
  services                    Service[]
  pendingDoctorProfileUpdates DoctorProfilePendingUpdate[]
  aiChatLogs                  AiChatLog[]
  rooms                       Room[]
  // Non-doctor staff (NURSE / LAB_TECH / RECEPTIONIST) grouped under this
  // specialty, purely for room-picker filtering — see User.specialtyId.
  usersWithSpecialty          User[]

  @@map("specialties")
}

model DoctorProfile {
  id              String                      @id @default(uuid()) @db.Char(36)
  userId          String                      @unique @map("user_id") @db.Char(36)
  specialtyId     String?                     @map("specialty_id") @db.Char(36)
  subspecialty    String?                     @db.VarChar(150)
  degree          String?                     @db.VarChar(100)
  certification   String?                     @db.Text
  yearsExperience Int?                        @map("years_experience") @db.SmallInt
  biography       String?                     @db.Text
  avatarUrl       String?                     @map("avatar_url") @db.Text
  approvalStatus  DoctorProfileApprovalStatus @default(APPROVED) @map("approval_status")
  approvedAt      DateTime?                   @map("approved_at")
  approvedBy      String?                     @map("approved_by") @db.Char(36)
  rejectedAt      DateTime?                   @map("rejected_at")
  rejectedBy      String?                     @map("rejected_by") @db.Char(36)
  rejectionReason String?                     @map("rejection_reason") @db.Text
  updatedAt       DateTime                    @default(now()) @updatedAt @map("updated_at")
  updatedBy       String?                     @map("updated_by") @db.Char(36)

  user               User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty          Specialty?                  @relation(fields: [specialtyId], references: [id])
  pendingUpdate      DoctorProfilePendingUpdate?
  certificationFiles DoctorCertificationFile[]

  @@index([specialtyId])
  @@index([approvalStatus])
  @@map("doctor_profiles")
}

model DoctorProfilePendingUpdate {
  id                    String                      @id @default(uuid()) @db.Char(36)
  doctorProfileId       String                      @unique @map("doctor_profile_id") @db.Char(36)
  specialtyId           String                      @map("specialty_id") @db.Char(36)
  subspecialty          String?                     @db.VarChar(150)
  degree                String?                     @db.VarChar(100)
  certification         String?                     @db.Text
  certificationFileUrls String?                     @map("certification_file_urls") @db.Text
  yearsExperience       Int?                        @map("years_experience") @db.SmallInt
  biography             String?                     @db.Text
  avatarUrl             String?                     @map("avatar_url") @db.Text
  status                DoctorProfileApprovalStatus @default(PENDING_APPROVAL)
  submittedBy           String                      @map("submitted_by") @db.Char(36)
  submittedAt           DateTime                    @default(now()) @map("submitted_at")
  reviewedBy            String?                     @map("reviewed_by") @db.Char(36)
  reviewedAt            DateTime?                   @map("reviewed_at")
  rejectionReason       String?                     @map("rejection_reason") @db.Text

  profile   DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  specialty Specialty     @relation(fields: [specialtyId], references: [id])

  @@index([status])
  @@index([submittedBy])
  @@map("doctor_profile_pending_updates")
}

model DoctorCertificationFile {
  id              String   @id @default(uuid()) @db.Char(36)
  doctorProfileId String   @map("doctor_profile_id") @db.Char(36)
  fileUrl         String   @map("file_url") @db.Text
  originalName    String?  @map("original_name") @db.VarChar(255)
  uploadedAt      DateTime @default(now()) @map("uploaded_at")
  uploadedBy      String?  @map("uploaded_by") @db.Char(36)

  profile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@index([doctorProfileId])
  @@map("doctor_certification_files")
}

// =====================================================================
// VI. SCHEDULE MODULE
// =====================================================================

model WorkSchedule {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  roomId    String?   @map("room_id") @db.Char(36)
  workDate  DateTime  @map("work_date") @db.Date
  shift     ShiftType
  note      String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy String    @map("created_by") @db.Char(36)
  updatedBy String?   @map("updated_by") @db.Char(36)

  // Version-up 0.2 Phase 2 #9 (Tình huống B, added 2026-08-19): lets ADMIN
  // mark this shift's doctor absent and swap in a substitute by overwriting
  // userId in place, rather than inserting a second row -- see
  // uq_schedule_user_date_shift / findRoomConflict comments above, which
  // already establish that 1 room/date/shift belongs to exactly 1 person.
  isAbsent       Boolean @default(false) @map("is_absent")
  absentNote     String? @map("absent_note") @db.VarChar(255)
  // Doctor originally on this shift before the first reassignment -- only
  // ever set once (kept across further reassignments) for audit/reporting.
  originalUserId String? @map("original_user_id") @db.Char(36)

  user User  @relation(fields: [userId], references: [id])
  room Room? @relation(fields: [roomId], references: [id])

  appointments Appointment[]

  @@unique([userId, workDate, shift], name: "uq_schedule_user_date_shift")
  // A DB-level uq_schedule_room_date_shift constraint on (roomId, workDate,
  // shift) alone was removed 2026-08-12 -- it did not account for role, so it
  // rejected a doctor and a nurse sharing the same room/date/shift (e.g. both
  // FULL_DAY) even though a room legitimately hosts 1 doctor + 1 nurse at
  // once. findRoomConflict in the use-case (scoped by role) is the only
  // guard now -- same application-layer-only tradeoff already documented for
  // partial constraints at the top of this file.
  @@index([userId, workDate])
  @@index([workDate])
  @@index([roomId, workDate])
  @@map("work_schedules")
}

// =====================================================================
// VII. APPOINTMENT MODULE
// =====================================================================

model Appointment {
  id              String            @id @default(uuid()) @db.Char(36)
  patientId       String            @map("patient_id") @db.Char(36)
  doctorId        String?           @map("doctor_id") @db.Char(36)
  serviceId       String?           @map("service_id") @db.Char(36)
  roomId          String?           @map("room_id") @db.Char(36)
  scheduleId      String?           @map("schedule_id") @db.Char(36)
  appointmentTime DateTime          @map("appointment_time")
  status          AppointmentStatus @default(PENDING)
  note            String?           @db.Text
  cancelReason    String?           @map("cancel_reason") @db.Text
  cancelledBy     String?           @map("cancelled_by") @db.Char(36)
  cancelledAt     DateTime?         @map("cancelled_at")
  checkedInAt     DateTime?         @map("checked_in_at")
  bookedBy        String            @map("booked_by") @db.Char(36)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @updatedAt @map("updated_at")

  patient  Patient       @relation(fields: [patientId], references: [id])
  doctor   User?         @relation("AppointmentDoctor", fields: [doctorId], references: [id])
  service  Service?      @relation(fields: [serviceId], references: [id])
  room     Room?         @relation(fields: [roomId], references: [id])
  schedule WorkSchedule? @relation(fields: [scheduleId], references: [id])

  history AppointmentHistory[]
  visit   Visit?
  invoice Invoice?

  @@index([patientId])
  @@index([doctorId, appointmentTime])
  @@index([status])
  @@index([appointmentTime])
  @@index([scheduleId])
  @@map("appointments")
}

model AppointmentHistory {
  id            String             @id @default(uuid()) @db.Char(36)
  appointmentId String             @map("appointment_id") @db.Char(36)
  oldStatus     AppointmentStatus? @map("old_status")
  newStatus     AppointmentStatus  @map("new_status")
  oldTime       DateTime?          @map("old_time")
  newTime       DateTime?          @map("new_time")
  oldDoctorId   String?            @map("old_doctor_id") @db.Char(36)
  newDoctorId   String?            @map("new_doctor_id") @db.Char(36)
  reason        String?            @db.Text
  changedAt     DateTime           @default(now()) @map("changed_at")
  changedBy     String             @map("changed_by") @db.Char(36)

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([appointmentId])
  @@map("appointment_history")
}

// =====================================================================
// VIII. VISIT & CLINICAL MODULE
// =====================================================================

model Visit {
  id            String        @id @default(uuid()) @db.Char(36)
  appointmentId String        @unique @map("appointment_id") @db.Char(36)
  patientId     String        @map("patient_id") @db.Char(36)
  doctorId      String        @map("doctor_id") @db.Char(36)
  roomId        String        @map("room_id") @db.Char(36)
  queueNumber   String?       @map("queue_number") @db.VarChar(20)
  // "<roomCode>-<seq>" (VD "PK01-042") â€” seq Ä‘áº¿m láº¡i tá»« 1 má»—i ngÃ y theo roomId,
  // sinh lÃºc check-in. KhÃ´ng Ä‘áº·t @@unique vÃ¬ reset theo ngÃ y.
  priority      VisitPriority @default(NORMAL)
  status        VisitStatus   @default(WAITING)
  calledAt      DateTime?     @map("called_at")
  calledCount   Int           @default(0) @map("called_count")
  startedAt     DateTime?     @map("started_at")
  completedAt   DateTime?     @map("completed_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  patient     Patient     @relation(fields: [patientId], references: [id])
  doctor      User        @relation("VisitDoctor", fields: [doctorId], references: [id])
  room        Room        @relation(fields: [roomId], references: [id])

  examinationResult ExaminationResult?
  clsOrders         ClsOrder[]
  prescription      Prescription?
  vitalSigns        VitalSigns?

  // NOTE: uq_one_inprogress_per_room (1 IN_PROGRESS visit per room) is a
  // partial unique index in the original design â€” enforce in application
  // layer (see top-of-file notes).
  @@index([doctorId, createdAt])
  @@index([patientId])
  @@index([status])
  @@index([roomId])
  @@map("visits")
}

model VitalSigns {
  id          String   @id @default(uuid()) @db.Char(36)
  visitId     String   @unique @map("visit_id") @db.Char(36)
  systolicBp  Int?     @map("systolic_bp")
  diastolicBp Int?     @map("diastolic_bp")
  heartRate   Int?     @map("heart_rate")
  temperature Decimal? @db.Decimal(4, 1)
  spo2        Int?
  weight      Decimal? @db.Decimal(5, 1)
  height      Decimal? @db.Decimal(5, 1)
  recordedBy  String   @map("recorded_by") @db.Char(36)
  recordedAt  DateTime @default(now()) @map("recorded_at")

  visit Visit @relation(fields: [visitId], references: [id])

  @@map("vital_signs")
}

model ExaminationResult {
  id                  String    @id @default(uuid()) @db.Char(36)
  visitId             String    @unique @map("visit_id") @db.Char(36)
  diagnosis           String    @db.Text
  clinicalNote        String?   @map("clinical_note") @db.Text
  treatmentResult     String?   @map("treatment_result") @db.Text
  followUpDate        DateTime? @map("follow_up_date") @db.Date
  accessCode          String    @unique @map("access_code") @db.VarChar(20)
  accessCodeExpiresAt DateTime? @map("access_code_expires_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy           String    @map("created_by") @db.Char(36)
  updatedBy           String?   @map("updated_by") @db.Char(36)

  visit Visit @relation(fields: [visitId], references: [id])

  @@index([accessCode])
  @@index([followUpDate])
  @@map("examination_results")
}

model ClsOrder {
  id        String         @id @default(uuid()) @db.Char(36)
  visitId   String         @map("visit_id") @db.Char(36)
  clsRoomId String         @map("cls_room_id") @db.Char(36)
  serviceId String         @map("service_id") @db.Char(36)
  note      String?        @db.Text
  status    ClsOrderStatus @default(PENDING)
  calledAt  DateTime?      @map("called_at")
  createdAt DateTime       @default(now()) @map("created_at")
  createdBy String         @map("created_by") @db.Char(36)

  visit   Visit   @relation(fields: [visitId], references: [id])
  clsRoom Room    @relation("ClsOrderRoom", fields: [clsRoomId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  result       ClsResult?
  invoiceItems InvoiceItem[]

  // NOTE: chk_cls_room_type (cls_room_id must reference a room with
  // type = 'CLS') and uq_one_inprogress_per_cls_room (partial unique index)
  // must be enforced in the application layer.
  @@index([visitId])
  @@index([clsRoomId])
  @@index([status])
  @@map("cls_orders")
}

model ClsResult {
  id         String   @id @default(uuid()) @db.Char(36)
  clsOrderId String   @unique @map("cls_order_id") @db.Char(36)
  resultData Json     @map("result_data")
  summary    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy  String   @map("created_by") @db.Char(36)
  updatedBy  String?  @map("updated_by") @db.Char(36)

  clsOrder    ClsOrder        @relation(fields: [clsOrderId], references: [id])
  attachments ClsAttachment[]

  @@map("cls_results")
}

model ClsAttachment {
  id          String             @id @default(uuid()) @db.Char(36)
  clsResultId String             @map("cls_result_id") @db.Char(36)
  fileName    String             @map("file_name") @db.VarChar(255)
  fileUrl     String             @map("file_url") @db.Text
  fileType    AttachmentFileType @map("file_type")
  fileSizeKb  Int?               @map("file_size_kb")
  uploadedAt  DateTime           @default(now()) @map("uploaded_at")
  uploadedBy  String             @map("uploaded_by") @db.Char(36)

  clsResult ClsResult @relation(fields: [clsResultId], references: [id], onDelete: Cascade)

  @@index([clsResultId])
  @@map("cls_attachments")
}

// =====================================================================
// IX. PRESCRIPTION MODULE
// =====================================================================

model Prescription {
  id        String   @id @default(uuid()) @db.Char(36)
  visitId   String   @unique @map("visit_id") @db.Char(36)
  note      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  createdBy String   @map("created_by") @db.Char(36)

  visit Visit              @relation(fields: [visitId], references: [id])
  items PrescriptionItem[]

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String  @id @default(uuid()) @db.Char(36)
  prescriptionId String  @map("prescription_id") @db.Char(36)
  medicineId     String  @map("medicine_id") @db.Char(36)
  dosage         String  @db.VarChar(100)
  frequency      String  @db.VarChar(100)
  durationDays   Int     @map("duration_days") @db.SmallInt
  instruction    String? @db.Text
  allergyWarning Boolean @default(false) @map("allergy_warning")
  sortOrder      Int     @default(0) @map("sort_order") @db.SmallInt

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine     Medicine     @relation(fields: [medicineId], references: [id])

  invoiceItems InvoiceItem[]

  @@index([prescriptionId])
  @@index([medicineId])
  @@map("prescription_items")
}

// =====================================================================
// X. INVOICE MODULE
// =====================================================================

model Invoice {
  id            String         @id @default(uuid()) @db.Char(36)
  appointmentId String         @unique @map("appointment_id") @db.Char(36)
  patientId     String         @map("patient_id") @db.Char(36)
  invoiceCode   String         @unique @map("invoice_code") @db.VarChar(30)
  subtotal      Decimal        @db.Decimal(15, 2)
  discount      Decimal        @default(0) @db.Decimal(15, 2)
  total         Decimal        @db.Decimal(15, 2)
  amountDue     Decimal        @map("amount_due") @db.Decimal(15, 2)
  paymentStatus PaymentStatus  @default(UNPAID) @map("payment_status")
  paymentMethod PaymentMethod? @map("payment_method")
  paidAt        DateTime?      @map("paid_at")
  note          String?        @db.Text
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")
  createdBy     String         @map("created_by") @db.Char(36)

  appointment Appointment      @relation(fields: [appointmentId], references: [id])
  patient     Patient          @relation(fields: [patientId], references: [id])
  items       InvoiceItem[]
  payments    InvoicePayment[]

  // NOTE: chk_invoice_total (total = subtotal - discount) and
  // chk_paid_has_method must be enforced in the application layer.
  // Version-up 0.2 item #10: amount_due is no longer required to equal
  // total — the payment lifecycle moved from "pay everything at once" to
  // "pay per InvoiceItem, in stages" (see InvoicePayment below), so
  // amount_due now tracks the sum of still-unpaid items and can legitimately
  // sit strictly between 0 and total while paymentStatus = PARTIALLY_PAID.
  // The DB-level chk_invoices_amount_due_calc CHECK constraint that used to
  // enforce amount_due = total is dropped in migration
  // 20260819130000_split_invoice_payment_by_stage.
  @@index([patientId])
  @@index([paymentStatus])
  @@index([createdAt(sort: Desc)])
  @@map("invoices")
}

model InvoiceItem {
  id            String          @id @default(uuid()) @db.Char(36)
  invoiceId     String          @map("invoice_id") @db.Char(36)
  itemType      InvoiceItemType @map("item_type")
  serviceRefId  String?         @map("service_ref_id") @db.Char(36)
  clsRefId      String?         @map("cls_ref_id") @db.Char(36)
  medicineRefId String?         @map("medicine_ref_id") @db.Char(36)
  name          String          @db.VarChar(150)
  unitPrice     Decimal         @map("unit_price") @db.Decimal(15, 2)
  quantity      Int             @default(1) @db.SmallInt
  amount        Decimal         @db.Decimal(15, 2)
  // Version-up 0.2 item #10: set when this specific line item has been
  // collected (via PayInvoiceUseCase) — null means still outstanding. Drives
  // both payment gates (ExaminationFeeNotPaidError / CLS gate in
  // CallPatientToClsUseCase) and the receptionist's per-line "collect now"
  // checkbox UI.
  paidAt        DateTime?       @map("paid_at")

  invoice      Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceRef   Service?             @relation(fields: [serviceRefId], references: [id])
  clsRef       ClsOrder?            @relation(fields: [clsRefId], references: [id])
  medicineRef  PrescriptionItem?    @relation(fields: [medicineRefId], references: [id])
  paymentItems InvoicePaymentItem[]

  // NOTE: chk_invoice_item_ref (exactly one of service/cls/medicine ref must
  // be set, matching item_type) and chk_invoice_item_amount
  // (amount = unit_price * quantity) must be enforced in the application
  // layer.
  @@index([invoiceId])
  @@map("invoice_items")
}

// Version-up 0.2 item #10: one row per "collect now" action a receptionist
// performs (thu phí khám / thu phí CLS / thu tiền thuốc, possibly spanning
// several rounds per Invoice) — replaces the old single Invoice.paidAt/
// paymentMethod-only model, which could only represent "paid everything at
// once". Invoice.paymentMethod/paidAt are kept for backward compatibility
// (best-effort "last known" values, see PayInvoiceUseCase) but
// InvoicePayment is now the source of truth for who collected what, when,
// and how — needed for per-stage receipt printing later (out of scope here).
model InvoicePayment {
  id        String        @id @default(uuid()) @db.Char(36)
  invoiceId String        @map("invoice_id") @db.Char(36)
  amount    Decimal       @db.Decimal(15, 2)
  method    PaymentMethod
  paidAt    DateTime      @map("paid_at")
  // Plain FK column, no Prisma relation to User — same convention already
  // used by Invoice.createdBy/InvoiceItem.* above (FK enforced at the DB
  // level only, see migration.sql).
  createdBy String        @map("created_by") @db.Char(36)
  note      String?       @db.VarChar(255)

  invoice Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  items   InvoicePaymentItem[]

  @@index([invoiceId])
  @@map("invoice_payments")
}

// Join table: which InvoiceItem rows a given InvoicePayment round covered.
model InvoicePaymentItem {
  invoicePaymentId String @map("invoice_payment_id") @db.Char(36)
  invoiceItemId    String @map("invoice_item_id") @db.Char(36)

  invoicePayment InvoicePayment @relation(fields: [invoicePaymentId], references: [id], onDelete: Cascade)
  invoiceItem    InvoiceItem    @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)

  @@id([invoicePaymentId, invoiceItemId])
  @@index([invoiceItemId])
  @@map("invoice_payment_items")
}

// =====================================================================
// XI. MEDICINE MODULE
// =====================================================================

model Medicine {
  id                String          @id @default(uuid()) @db.Char(36)
  name              String          @unique @db.VarChar(150)
  activeIngredient  String          @map("active_ingredient") @db.VarChar(200)
  dosageForm        String          @map("dosage_form") @db.VarChar(50)
  unit              MeasurementUnit
  price             Decimal?        @db.Decimal(15, 2)
  contraindications String?         @db.Text
  description       String?         @db.Text
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at")
  createdBy         String          @map("created_by") @db.Char(36)
  updatedBy         String?         @map("updated_by") @db.Char(36)
  deletedAt         DateTime?       @map("deleted_at")

  prescriptionItems PrescriptionItem[]

  @@index([name])
  @@index([activeIngredient])
  @@map("medicines")
}

// =====================================================================
// XII. SUPPLY MODULE
// =====================================================================

model SupplyCategory {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy   String    @map("created_by") @db.Char(36)
  updatedBy   String?   @map("updated_by") @db.Char(36)
  deletedAt   DateTime? @map("deleted_at")

  supplies Supply[]

  @@map("supply_categories")
}

model Supplier {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @unique @db.VarChar(150)
  phone       String?   @db.VarChar(15)
  email       String?   @db.VarChar(150)
  address     String?   @db.Text
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  createdBy   String    @map("created_by") @db.Char(36)
  updatedBy   String?   @map("updated_by") @db.Char(36)
  deletedAt   DateTime? @map("deleted_at")

  imports SupplyImport[]

  @@map("suppliers")
}

model Supply {
  id            String          @id @default(uuid()) @db.Char(36)
  categoryId    String          @map("category_id") @db.Char(36)
  name          String          @db.VarChar(150)
  unit          MeasurementUnit
  currentStock  Int             @default(0) @map("current_stock")
  minStockLevel Int             @default(0) @map("min_stock_level")
  description   String?         @db.Text
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at")
  createdBy     String          @map("created_by") @db.Char(36)
  updatedBy     String?         @map("updated_by") @db.Char(36)
  deletedAt     DateTime?       @map("deleted_at")

  category SupplyCategory @relation(fields: [categoryId], references: [id])

  importItems  SupplyImportItem[]
  transactions SupplyTransaction[]

  @@unique([name, categoryId], name: "uq_supply_name_category")
  @@index([categoryId])
  @@index([currentStock])
  @@map("supplies")
}

model SupplyImport {
  id         String   @id @default(uuid()) @db.Char(36)
  supplierId String   @map("supplier_id") @db.Char(36)
  importDate DateTime @default(dbgenerated("(curdate())")) @map("import_date") @db.Date
  totalValue Decimal? @map("total_value") @db.Decimal(15, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  createdBy  String   @map("created_by") @db.Char(36)

  supplier Supplier @relation(fields: [supplierId], references: [id])

  items        SupplyImportItem[]
  transactions SupplyTransaction[]

  @@map("supply_imports")
}

model SupplyImportItem {
  id         String    @id @default(uuid()) @db.Char(36)
  importId   String    @map("import_id") @db.Char(36)
  supplyId   String    @map("supply_id") @db.Char(36)
  quantity   Int
  unitPrice  Decimal   @map("unit_price") @db.Decimal(15, 2)
  expiryDate DateTime? @map("expiry_date") @db.Date

  import SupplyImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  supply Supply       @relation(fields: [supplyId], references: [id])

  @@index([supplyId])
  @@map("supply_import_items")
}

model SupplyTransaction {
  id              String                @id @default(uuid()) @db.Char(36)
  supplyId        String                @map("supply_id") @db.Char(36)
  transactionType SupplyTransactionType @map("transaction_type")
  quantity        Int
  importId        String?               @map("import_id") @db.Char(36)
  roomId          String?               @map("room_id") @db.Char(36)
  note            String?               @db.Text
  createdAt       DateTime              @default(now()) @map("created_at")
  createdBy       String                @map("created_by") @db.Char(36)

  supply Supply        @relation(fields: [supplyId], references: [id])
  import SupplyImport? @relation(fields: [importId], references: [id])
  room   Room?         @relation(fields: [roomId], references: [id])

  // NOTE: chk_supply_tx_quantity (sign convention per transaction_type),
  // chk_supply_tx_import_ref (IMPORT requires import_id) and
  // chk_supply_tx_room_ref (DISTRIBUTE requires room_id) must be
  // enforced in the application layer. The auto stock-update trigger
  // (fn_update_supply_stock) must also be replicated in the use-case layer.
  @@index([supplyId])
  @@index([transactionType])
  @@index([createdAt(sort: Desc)])
  @@map("supply_transactions")
}

// =====================================================================
// XIII. NOTIFICATION MODULE
// =====================================================================

model NotificationLog {
  id         String              @id @default(uuid()) @db.Char(36)
  userId     String?             @map("user_id") @db.Char(36)
  recipient  String              @db.VarChar(150)
  channel    NotificationChannel
  type       String              @db.VarChar(50)
  subject    String?             @db.VarChar(255)
  body       String              @db.Text
  status     NotificationStatus  @default(PENDING)
  sentAt     DateTime?           @map("sent_at")
  errorMsg   String?             @map("error_msg") @db.Text
  retryCount Int                 @default(0) @map("retry_count") @db.SmallInt
  refId      String?             @map("ref_id") @db.Char(36)
  isRead     Boolean             @default(false) @map("is_read")
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, isRead])
  @@index([status])
  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@map("notification_logs")
}

