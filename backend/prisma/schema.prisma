// XIV. MESSAGE MODULE
// =====================================================================

model AppMessage {
  id          String @id @default(uuid()) @db.Char(36)
  messageCode String @map("message_code") @db.VarChar(20)
  locale      String @default("vi") @db.VarChar(5)
  message     String @db.Text

  @@unique([messageCode, locale])
  @@map("app_messages")
}

// =====================================================================
// XV. AUDIT & LOG MODULE
// =====================================================================

model SystemLog {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String?  @map("user_id") @db.Char(36)
  action    String   @db.VarChar(30)
  module    String   @db.VarChar(30)
  targetId  String?  @map("target_id") @db.Char(36)
  detail    Json?
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@index([module])
  @@index([action])
  @@map("system_logs")
}

// =====================================================================
// XVI. AI MODULE
// =====================================================================

model AiChatLog {
  id                   String   @id @default(uuid()) @db.Char(36)
  userId               String?  @map("user_id") @db.Char(36)
  sessionId            String   @map("session_id") @db.Char(36)
  role                 String   @db.VarChar(10)
  message              String   @db.Text
  suggestedSpecialtyId String?  @map("suggested_specialty_id") @db.Char(36)
  createdAt            DateTime @default(now()) @map("created_at")

  user               User?      @relation(fields: [userId], references: [id])
  suggestedSpecialty Specialty? @relation(fields: [suggestedSpecialtyId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@index([createdAt(sort: Desc)])
  @@map("ai_chat_logs")
}
